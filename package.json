{
  "name": "dsh-project-canvas",
  "version": "0.3.6",
  "description": "Project Canvas boards inside DeepSeek Harness: a pannable, editable canvas page and canvas tools for the agent.",
  "type": "module",
  "license": "MIT",
  "author": "longroeec <longroeec@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longroeec/dsh-project-canvas.git"
  },
  "homepage": "https://github.com/longroeec/dsh-project-canvas#readme",
  "bugs": {
    "url": "https://github.com/longroeec/dsh-project-canvas/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "canvas",
    "notes",
    "project-canvas"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <1.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@lexical/code": "^0.53.0",
    "@lexical/headless": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "lexical": "^0.53.0",
    "puppeteer-core": "^25.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
